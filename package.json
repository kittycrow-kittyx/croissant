{
  "name": "@kitty-crow/croissant",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Bake-lowered TypeScript to freestanding C transpiler",
  "bin": {
    "croissant": "./src/cli.ts"
  },
  "scripts": {
    "build": "bun run guards && bun run check",
    "check": "bun --bun tsc -p tsconfig.json --noEmit",
    "test": "bun test --timeout 60000 test",
    "test:source-contract": "bun test --timeout 60000 test/compiler.test.ts",
    "test:modular-c": "bun test --timeout 60000 test/project.test.ts",
    "compile": "bun src/cli.ts",
    "guards": "bash scripts/guards.sh"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@kitty-crow/code-guards": "git+https://github.com/kitty-crow/code-guards.git#a790861394c7312ff512ec9b03346e1fc8268188"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "typescript": "~5.8.3"
  }
}
